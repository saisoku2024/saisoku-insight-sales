{
  "name": "saisoku-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "build:clean": "node scripts/clean-next.mjs && next build",
    "start": "next start -p 3004",
    "lint": "eslint",
    "audit:direct-write": "node scripts/direct-write-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "verify": "npm run audit:direct-write && npm run lint && npx tsc --noEmit --pretty false && npm run test:e2e:list && npm run build:clean",
    "backup:data:full": "node scripts/backup-data.mjs --mode full",
    "backup:data:critical": "node scripts/backup-data.mjs --mode critical --retention-days 14"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "next": "^16.2.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "styled-jsx": "^5.1.6",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.8",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
